[Unit]
Description=Weather app API proxy (Avoro canary)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
DynamicUser=true
User=weather-canary
Group=weather-canary
WorkingDirectory=/srv/canary/weather.micutu.com/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8105
Environment=TRUST_PROXY=true
Environment=APP_VERSION=2.0.0
Environment=PUBLIC_ORIGIN=https://weather.micutu.com
EnvironmentFile=/srv/canary/weather.micutu.com/app/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
MemoryMax=256M
TasksMax=64
LimitNOFILE=1024
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
ProtectClock=true
ProtectHostname=true
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
